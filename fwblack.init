#!/bin/sh /etc/rc.common
# fwblack - procd init script for OpenWrt.
# Install: cp fwblack.init /etc/init.d/fwblack && chmod +x /etc/init.d/fwblack
#          service fwblack enable && service fwblack start

USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance fwblack
	procd_set_param command /etc/fw.black/fw-black.sh
	# Optional overrides (defaults: INTERVAL=300, INTERVAL_JITTER=30, TABLE=fwblack):
	# procd_set_param env INTERVAL=300 INTERVAL_JITTER=30 TABLE=fwblack SET_V4=blacklist_v4 SET_V6=blacklist_v6
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
